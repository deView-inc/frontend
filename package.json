{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "build": "next build",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint",
