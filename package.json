        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "steiger": "^0.6.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
