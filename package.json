        "prepare": "husky",
        "start:dev": "next dev",
        "start:prod": "next start"
    },
    "dependencies": {
        "next": "16.3.0",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
